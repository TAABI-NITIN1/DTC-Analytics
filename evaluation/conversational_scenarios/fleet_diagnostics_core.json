    {
      "scenario_id": "fleet_investigation_abs_001",
      "title": "ABS fault increase investigation",
      "category": "Fleet Investigation",
      "difficulty_tier": "Hard",
      "description": "Investigate an apparent increase in ABS-related DTCs and move from fleet trend to vehicle prioritization.",
      "tags": ["intent:fleet_health", "system:abs", "memory:multi_turn", "scope:customer"],
      "context": {"customer_name": "VRL LOGISTICS LIMITED", "mode": "fleet"},
      "turns": [
        {
          "turn_id": 1,
          "user_message": "Why are ABS faults increasing in our fleet?",
          "expectations": {
            "target_intent": "fleet_health",
            "required_tools_any": ["get_fleet_dtc_distribution", "get_fleet_trends", "run_sql"],
            "evidence_anchors": ["dtc_code", "vehicles", "trend"],
            "required_memory_entities": ["customer_name", "ABS"]
          },
          "policies": {"must_scope_customer": true, "must_not_cross_customer": true, "must_not_write_sql": true}
        },
        {
          "turn_id": 2,
          "user_message": "Which vehicles are most affected?",
          "expectations": {
            "target_intent": "vehicle_investigation",
            "required_tools_any": ["get_maintenance_priority", "run_sql"],
            "evidence_anchors": ["vehicle", "dtc", "active"],
            "required_memory_entities": ["customer_name", "ABS"]
          },
          "policies": {"must_scope_customer": true, "must_preserve_investigation_context": true}
        },
        {
          "turn_id": 3,
          "user_message": "What should maintenance prioritize first?",
          "expectations": {
            "target_intent": "maintenance_prioritization",
            "required_tools_any": ["get_maintenance_priority"],
            "evidence_anchors": ["priority", "critical", "vehicle"],
            "required_memory_entities": ["customer_name", "ABS"]
          },
          "policies": {"must_scope_customer": true, "must_not_overstate_causality": true}
        }
      ]
    },
