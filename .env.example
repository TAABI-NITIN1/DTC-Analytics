# API Keys (Required to enable respective provider)
ANTHROPIC_API_KEY="your_anthropic_api_key_here"       # Required: Format: sk-ant-api03-...
AI_ANALYST_MODEL_NAME="claude-haiku-4-5-20251001"
AI_ANALYST_SQL_PLANNER_MODEL="claude-haiku-4-5-20251001"
PERPLEXITY_API_KEY="your_perplexity_api_key_here"     # Optional: Format: pplx-...
OPENAI_API_KEY="your_openai_api_key_here"             # Optional, for OpenAI models. Format: sk-proj-...
GOOGLE_API_KEY="your_google_api_key_here"             # Optional, for Google Gemini models.
MISTRAL_API_KEY="your_mistral_key_here"               # Optional, for Mistral AI models.
XAI_API_KEY="YOUR_XAI_KEY_HERE"                       # Optional, for xAI AI models.
GROQ_API_KEY="YOUR_GROQ_KEY_HERE"                     # Optional, for Groq models.
OPENROUTER_API_KEY="YOUR_OPENROUTER_KEY_HERE"         # Optional, for OpenRouter models.
AZURE_OPENAI_API_KEY="your_azure_key_here"            # Optional, for Azure OpenAI models (requires endpoint in .taskmaster/config.json).
OLLAMA_API_KEY="your_ollama_api_key_here"             # Optional: For remote Ollama servers that require authentication.
GITHUB_API_KEY="your_github_api_key_here"             # Optional: For GitHub import/export features. Format: ghp_... or github_pat_...

# DTC Analytics MCP (use a dedicated ClickHouse user with SELECT-only grants in production)
CLICKHOUSE_READONLY_USER="dtc_mcp_readonly"
DTC_MCP_CH_DB_Host="clickhouse-host"
DTC_MCP_CH_DB_Port="8123"
DTC_MCP_CH_DB_User="dtc_mcp_readonly"
DTC_MCP_CH_DB_Password="replace-at-deploy-time"
DTC_MCP_CH_DB_Database="default"
DTC_MCP_TIMEOUT_SECONDS="15"
DTC_MCP_MAX_ROWS="200"
DTC_MCP_MAX_RESULT_BYTES="10000000"
DTC_MCP_MAX_LOOKBACK_DAYS="365"
DTC_MCP_ALLOWED_DATABASE="default"
DTC_MCP_DYNAMIC_SQL_ENABLED="false"
DTC_MCP_DIRECT_FALLBACK_ENABLED="false"
DTC_DATA_ACCESS_MODE="direct"
DTC_MCP_TRANSPORT="stdio"
DTC_MCP_URL="http://127.0.0.1:8001/mcp"
DTC_MCP_HTTP_HOST="127.0.0.1"
DTC_MCP_HTTP_PORT="8001"
DTC_MCP_HOST="127.0.0.1"
DTC_MCP_PORT="8001"
DTC_MCP_WORKERS="1"
DTC_MCP_CONCURRENCY="100"
DTC_MCP_AUTH_MODE="signed_hmac"
DTC_MCP_ALLOWED_ORIGINS=""
DTC_MCP_IDENTITY_HMAC_SECRET="replace-at-deploy-time"
DTC_MCP_CONVERSATION_STATE_HMAC_SECRET="replace-at-deploy-time"
DTC_MCP_CACHE_TTL_SECONDS="30"
DTC_ANALYTICS_CHECKPOINT="unknown"
REDIS_URL=""
DTC_MCP_AUDIT_PERSIST_ENABLED="false"
DTC_MCP_REDACT_FIELDS=""
